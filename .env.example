# Copy this file to .env and fill in real values. Never commit .env.

# --- Watchlist & timeframes -------------------------------------------------
# Comma-separated. Symbols use yfinance-style FX tickers (e.g. EURUSD=X).
WATCHLIST=EURUSD=X,GBPUSD=X,USDJPY=X,AUDUSD=X,USDCAD=X,NZDUSD=X,USDCHF=X
TIMEFRAMES=4h,1h,15m

# --- Risk management ---------------------------------------------------------
ACCOUNT_SIZE_USD=10000
RISK_PERCENT_PER_TRADE=1.0
MIN_RISK_REWARD=2.0

# --- Regime thresholds --------------------------------------------------------
ADX_TREND_THRESHOLD=25
ATR_EXPANSION_MULTIPLIER=1.5
BB_SQUEEZE_PERCENTILE=20

# --- Data provider -------------------------------------------------------------
# The only implemented OHLCV adapter is yfinance (historical/delayed bars, not
# verified real-time quotes). New recommendation publication remains blocked
# until a tested real-time provider adapter is added.
DATA_PROVIDER=yfinance
# tradingview_ta needs no key, but yfinance rate-limits — keep polling interval sane.
SCAN_INTERVAL_SECONDS=300

# --- 1-hour auto-scan scheduler --------------------------------------------------
# Scans the dynamic watchlist (data/watchlist.json — seeded with defaults,
# grown via Telegram /add and successful /scan requests) on this interval.
# Only high-confidence, actively-triggered setups are pushed; everything
# else stays silent (see src/scanner_2_strategy.py + min_signal_confidence).
AUTO_SCAN_INTERVAL_SECONDS=3600
MIN_SIGNAL_CONFIDENCE=0.72
# Checklist score threshold (0-100); this is not a measured win probability.
MIN_SIGNAL_QUALITY_SCORE=70
# Optional: send a no-signal status notification after each scan cycle.
# Disabled by default to avoid repetitive messages when the market is quiet.
NOTIFY_NO_SIGNALS=false

# When enabled, an unavailable/stale economic calendar pauses recommendation
# publication until a valid calendar response is restored.
ENABLE_NEWS_FILTER=true
NEWS_BUFFER_MINUTES=30

# Final publish gate applied to every publish path (auto-scan, /scan_all,
# publish button, TradingView webhook). FX/metals weekend closure is mandatory
# and cannot be disabled. Live recommendations also require a verified live feed.
ENABLE_MTF_FILTER=true            # reject if the higher timeframe opposes the trade
ENABLE_DXY_FILTER=true            # gold only; skipped (allowed) when DXY data is unavailable
ENABLE_MARKET_HOURS_FILTER=true   # legacy setting; closure is enforced regardless of this value
OUTCOME_CHECK_INTERVAL_SECONDS=300  # follow open trades until TP/SL every 5 minutes

# --- TradingView webhook bridge ------------------------------------------------
# Bind Uvicorn as required by your host; public deployments must terminate TLS
# at a reverse proxy and must not expose this plain-HTTP port directly.
WEBHOOK_HOST=0.0.0.0
WEBHOOK_PORT=8000
# Optional on Railway: mount a persistent Volume at /data, then set this variable.
# FOREX_DATA_DIR=/data
# Generate a unique random secret of at least 32 characters. The placeholder below is rejected.
# TradingView must send the exact secret in the alert JSON body ("secret" field).
WEBHOOK_SHARED_SECRET=REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
# Optional: accept webhook calls only from TradingView's published IPs. Behind a
# hosting proxy (Railway) also set FORWARDED_ALLOW_IPS=* so the real sender IP is seen.
WEBHOOK_ENFORCE_TV_IPS=false
# Optional: alert the admin when no authenticated TradingView alert arrived for N minutes (0 = off).
TRADINGVIEW_HEARTBEAT_MINUTES=0

# --- Notifications ---------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Control chat/group ID. It is not used as a fallback destination for trade signals.
# Telegram numeric admin user ID; commands and private operational alerts require this.
TELEGRAM_ALLOWED_USER_ID=
# Required destination for trade recommendations and their outcomes; no private-chat fallback.
TELEGRAM_CHANNEL_ID=
DISCORD_WEBHOOK_URL=
ENABLE_DESKTOP_NOTIFICATIONS=false

# On-demand Telegram /scan (or plain-text ticker): which timeframe actually
# drives the trade signal; the other TIMEFRAMES are shown for context only.
TELEGRAM_PRIMARY_TIMEFRAME=1h

# --- Optional evidence-based review of closed recommendations ---------------------
# Disabled by default. When enabled, local statistics are sent by private
# Telegram message to TELEGRAM_ALLOWED_USER_ID; no model is used without these.
AI_REVIEW_ENABLED=false
AI_REPORT_INTERVAL_HOURS=24
# Optional OpenAI-compatible provider; remote use requires HTTPS and explicit key.
AI_API_BASE_URL=
AI_API_KEY=
AI_MODEL=

# --- Paper trading (OANDA v20 practice/demo account) -----------------------------
# Opt-in — existing alert-only behavior is unaffected unless this is true.
# Sign up for a free practice account at https://www.oanda.com to get these.
# src/oanda_client.py refuses to run unless PAPER_TRADING_ENV=practice — it
# will never construct a live-money OANDA URL from this config.
ENABLE_PAPER_TRADING=false
PAPER_ACCOUNT_ID=your_paper_account_id
PAPER_API_TOKEN=your_paper_api_token
PAPER_TRADING_ENV=practice

LOG_LEVEL=INFO
